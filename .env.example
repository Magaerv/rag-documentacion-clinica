# Azure OpenAI — Portal: recurso de Azure OpenAI o proyecto de AI Foundry
AZURE_OPENAI_ENDPOINT=https://TU-RECURSO.openai.azure.com/
AZURE_OPENAI_API_KEY=
# Vacío = API v1 (recomendado). Completar solo si un modelo exige versión con fecha.
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT_EMBEDDINGS=text-embedding-3-small
AZURE_OPENAI_DEPLOYMENT_CHAT=gpt-5.4-mini

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://TU-SERVICIO.search.windows.net
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=documentacion-clinica

# Segmentación
TAMANO_FRAGMENTO=800
SOLAPAMIENTO=150

# Recuperación
TOP_K=5
UMBRAL_RELEVANCIA=0.62
